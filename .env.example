# ============================================================
# SEOHack — SEO App (o cérebro). NUNCA commitar o .env real.
# Local: node --env-file=.env <script>
# ============================================================

# --- Neon ---
# POOLED: usar em funções serverless (F8, crons). Tem -pooler no host.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.sa-east-1.aws.neon.tech/htf?sslmode=require"
# UNPOOLED: só para migrações (DDL não funciona bem via PgBouncer transaction mode)
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxx.sa-east-1.aws.neon.tech/htf?sslmode=require"

# --- Tenant ---
CLIENT_DOMAIN="hacktechfarm.com.br"

# --- LLM (sem nome de modelo fixo no PRD — ver C9 da auditoria) ---
LLM_PROVIDER="anthropic"           # anthropic | openai
LLM_MODEL="claude-sonnet-4-5"      # satélites
LLM_MODEL_PILLAR="claude-opus-4-5" # pillar pages
LLM_API_KEY=""
MONTHLY_BUDGET_USD="50"
MAX_ARTICLES_PER_RUN="2"

# --- Destino de publicação: adapter github ---
# Fine-grained token, acesso SÓ ao repositório do site, permissão
# Contents: Read and write. Nada além disso.
GITHUB_TOKEN=""
GITHUB_REPO="taleshack-prog/Hack-Tech-Farm-site"

# --- Ponte com o repo do site (adapter webhook, não usado) ---
PUBLISH_URL="https://hacktechfarm.com.br/api/f8/publish"
PUBLISH_TOKEN=""        # 64 chars — openssl rand -hex 32
F8_SIGNING_SECRET=""    # 64 chars — openssl rand -hex 32

# --- Google Search Console (service account com acesso à propriedade) ---
GSC_CLIENT_EMAIL=""
GSC_PRIVATE_KEY=""      # com \n literais; o código faz o replace
GSC_PROPERTY="sc-domain:hacktechfarm.com.br"

# --- GEO ---
PERPLEXITY_API_KEY=""

# --- Dashboard (fila de revisão) ---
# A URL é pública na Vercel: sem estas duas, qualquer pessoa publica no site.
# Gerar com: openssl rand -hex 32
DASHBOARD_PASSWORD=""
DASHBOARD_SECRET=""

# --- Alertas ---
BREVO_API_KEY=""
ALERT_EMAIL="tales@hacktechfarm.com.br"

# --- Provisionado automaticamente pela Vercel ---
CRON_SECRET=""
